APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Lagos
# Only when cPanel serves a separate web root: /home/CPANELUSER/public_html
# APP_PUBLIC_PATH=

# Stripe test keys — replace in cPanel/domain environment; never commit live keys.
STRIPE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PREMIUM_PRICE_ID=price_REPLACE_ME
CREATOR_REVENUE_SHARE=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Football data and automated newsroom
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_MAX_REQUESTS_PER_MINUTE=10
API_FOOTBALL_KEY=
API_FOOTBALL_URL=https://v3.football.api-sports.io
API_FOOTBALL_DAILY_BUDGET=95
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free
OPENROUTER_MAX_DAILY_REQUESTS=2000

# Analytics and X growth engine
CLARITY_PROJECT_ID=y6xi1c2mjp
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=
GROWTH_X_DAILY_LIMIT=8

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Live data, story cards, reels and social posting (see AGENTS.md at the repo root) ---
# ESPN live feed: run migrations first. Shadow mode only records ESPN's view for comparison.
ESPN_ENABLED=false
ESPN_SHADOW=true
# 20-second full-time reel: off | server | github (prove `server` with: cd reel && npm ci && node check.mjs)
REEL_RENDERER=off
REEL_NODE=node
REEL_VOICE=en
# Kokoro commentary over new reels (needs the radio runtime: Node 22.13+, radio/node_modules)
REEL_NARRATION=false
REEL_NARRATION_VOICE=bm_george
REEL_DELAY_MINUTES=3
REEL_GITHUB_REPO=richardawe/matchday_2
REEL_GITHUB_TOKEN=
# Buffer posts cards and reels to X, Instagram and TikTok. List channel IDs with
# `php artisan buffer:publish --channels`. APP_URL must be the public https address.
BUFFER_API_KEY=
BUFFER_MODE=shareNow
BUFFER_CHANNEL_X=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_TIKTOK=
# Planned posts (news, fixture previews, morning fixtures, night results), planned every 10 min.
# Each account posts at most once per slot (Lagos times), live cards and reels included.
# Off until switched on; see /admin/twitter.
BUFFER_AUTO=false
BUFFER_SLOTS=08:00,13:00,19:00
BUFFER_PREVIEWS_PER_DAY=3
# Buffer API requests a month (free plan: 3000). Posting stops at the hard limit.
BUFFER_MONTHLY_REQUESTS=3000
BUFFER_SOFT_LIMIT=2500
BUFFER_HARD_LIMIT=2900

# The reels-first homepage. Preview any time at /?home=v2; with it on, the 3D arena moves to /war/arena.
HOME_V2=false

# Matchday Radio: 06:00, 12:00 and 18:00 Africa/Lagos. Start in draft mode.
RADIO_ENABLED=false
RADIO_AUTO_PUBLISH=false
RADIO_NODE=node
RADIO_FFMPEG=ffmpeg
RADIO_VOICE=bm_george
# OpenRouter model for radio scripts and fact checks; empty uses OPENROUTER_MODEL.
RADIO_MODEL=
# Comma-separated names from config/news.php, only after reuse permission is confirmed.
RADIO_NEWS_SOURCES=

# Growth: the WhatsApp channel invite link (https://whatsapp.com/channel/...). The "Join our
# WhatsApp channel" CTA on the homepage and match pages stays hidden while this is empty.
WHATSAPP_CHANNEL_URL=

# Live Griot timeline (config/griot.php, docs in griot-ml/README.md). Run migrations first.
GRIOT_TIMELINE=false
# Kokoro voice clips for each post (needs the radio Node runtime and FFmpeg)
GRIOT_VOICE=false
GRIOT_VOICE_BLEND=bm_george:0.6,am_onyx:0.4
GRIOT_VOICE_SPEED=0.92
# Small writer model in storage/app/griot/writer (griot-ml/train_writer.py); off = Griot templates
GRIOT_WRITER=false
# Learned moment picker (griot-ml/train_picker.py); missing file = strict rules
# GRIOT_PICKER_MODEL=/home/matchdayaf/matchday-africa/storage/app/griot/picker.json
