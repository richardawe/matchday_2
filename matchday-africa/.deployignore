# Files and directories to exclude from production deployment

# Development files
.env.local
.env.backup*
.env.example
.env.development

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
storage/logs/*.log
error_log
*.log

# Cache files
bootstrap/cache/packages.php
bootstrap/cache/services.php
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# Test files
tests/
phpunit.xml
test-*.php

# Development scripts
deploy.sh
deploy_prediction_system.sql
deploy_previews_system.sh
create_admin_user.php
fix-standings-table.php
insert_admin_users.sql

# Backup files
*.backup
*.bak
*.old

# Node modules (if not needed in production)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git
.git/
.gitignore

# Documentation
README.md
PRODUCTION_DEPLOYMENT.md
DEPLOYMENT_CHECKLIST.md

# Temporary files
tmp/
temp/
