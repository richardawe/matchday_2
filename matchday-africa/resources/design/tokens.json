{
  "name": "Matchday Africa video and social design language",
  "version": "2026-11-17",
  "docs": "docs/design-language.md",

  "canvas": { "width": 1080, "height": 1920, "fps": 30 },

  "colour": {
    "black": "#0A0A0A",
    "yellow": "#FFD23F",
    "white": "#FFFFFF",
    "grey": "#C8C8C8",
    "surface": "#1B1B1B",
    "red": "#E10600"
  },
  "colour_roles": {
    "black": "Brand black: the backdrop of every frame and the panel behind yellow text.",
    "yellow": "Brand yellow: hooks, chips, highlights, the banter card. Text in yellow only on black.",
    "white": "Body text and headlines on black; the radio caption panel.",
    "grey": "Muted labels, sub-lines and the photo credit.",
    "surface": "Black lifted one step for cards and rows on the black backdrop (counts as black for contrast).",
    "red": "Signal only: red cards and losses. Never a background for a whole frame."
  },
  "team_colour_use": ["band", "score_block", "flag", "swatch", "chip_edge", "bar"],
  "team_fallback": { "home": ["#0A0A0A", "#FFD23F"], "away": ["#FFD23F", "#0A0A0A"] },

  "contrast": {
    "black":   ["yellow", "white", "grey"],
    "surface": ["yellow", "white", "grey"],
    "yellow":  ["black"],
    "white":   ["black"],
    "red":     ["white"],
    "grey":    ["black"],
    "team":    ["black", "white"],
    "photo":   []
  },

  "font": {
    "display":  { "file": "resources/fonts/Anton-Regular.ttf",  "family": "Anton", "weight": 400 },
    "regular":  { "file": "resources/fonts/Inter-Regular.ttf",  "family": "Inter", "weight": 400 },
    "semibold": { "file": "resources/fonts/Inter-SemiBold.ttf", "family": "Inter", "weight": 600 },
    "bold":     { "file": "resources/fonts/Inter-Bold.ttf",     "family": "Inter", "weight": 700 }
  },

  "type": {
    "hook":     { "font": "display",  "size": 120, "min": 96,  "leading": 1.08 },
    "headline": { "font": "display",  "size": 72,  "min": 56,  "leading": 1.12 },
    "score":    { "font": "display",  "size": 160, "min": 120, "leading": 1.0 },
    "strip":    { "font": "display",  "size": 56,  "min": 36,  "leading": 1.1 },
    "caption":  { "font": "bold",     "size": 52,  "min": 40,  "leading": 1.25 },
    "body":     { "font": "semibold", "size": 40,  "min": 32,  "leading": 1.3 },
    "strong":   { "font": "bold",     "size": 40,  "min": 32,  "leading": 1.3 },
    "label":    { "font": "bold",     "size": 28,  "min": 24,  "leading": 1.2 },
    "credit":   { "font": "regular",  "size": 20,  "min": 18,  "leading": 1.2 }
  },
  "case": {
    "rule": "Sentence case everywhere. Capitals only for the score and the minute.",
    "upper_allowed": ["score", "minute"]
  },

  "grid": {
    "safe": { "top": 250, "bottom": 1540, "left": 80, "right": 940 },
    "unsafe": { "top": 250, "bottom": 380, "right": 140 },
    "max_empty": 0.35,
    "gap": 24,
    "radius": 18,
    "logo": { "x": 80, "y": 124, "size": 96, "file": "public/icons/icon-512.png" },
    "scoreboard": { "top": 262, "height": 112 },
    "chips": { "top": 398, "height": 64 },
    "body": { "top": 486, "bottom": 1540 },
    "photo": { "top": 250, "bottom": 1024 },
    "caption": { "top": 1048, "bottom": 1540 },
    "credit": { "baseline": 1532 },
    "flag": { "width": 84 }
  },

  "motion": {
    "ease": [0.2, 0.8, 0.2, 1.0],
    "in": 0.35,
    "out": 0.35,
    "transition": 0.35,
    "word_stagger": 0.07,
    "line_stagger": 0.12,
    "item_stagger": 0.15,
    "lift": 46,
    "punch": 1.35,
    "flash": 0.1,
    "ken_burns": { "from": 1.0, "to": 1.06, "anchor_y": 0.4, "every": 3 },
    "cut": { "min": 3.0, "max": 5.0, "default": 4.0, "hook": 3.0 },
    "band": { "width": 300, "slant": 0.45, "edge": 26 }
  },

  "music": {
    "file": "resources/audio/matchday_original_beat_v1.mp3",
    "title": "Matchday original beat v1",
    "owner": "Matchday Africa",
    "loudness": { "i": -14, "tp": -2, "lra": 11 },
    "duck_under_voice": 0.18,
    "fade_in": 0.3,
    "fade_out": 2.0
  },

  "images": {
    "rule": "Licensed player photos with an on-screen credit, or our own renders. No crests, club logos, broadcast footage, agency or watermarked images.",
    "own_render_dirs": ["public/war/army", "resources/armies", "public/images/radio", "public/icons", "resources/flags", "storage/app/story-cards", "storage/app/fixture-cards"],
    "banned_dirs": ["public/war/warriors", "public/generated/players"]
  },

  "copy": {
    "allowed_acronyms": ["CC BY-SA", "CC BY-NC", "CC BY", "CC0"],
    "banned": [
      { "id": "quietly", "pattern": "\\bquietly\\b", "why": "Filler adverb." },
      { "id": "not-x-but-y", "pattern": "\\b(it['’]?s|it is|this is|that['’]?s)\\s+not\\b[^.!?]{1,80}?[,;:\\x{2014}\\x{2013}-]\\s*(it['’]?s|it is|this is|that['’]?s)\\b", "why": "The \"it's not X, it's Y\" formula." },
      { "id": "most-people", "pattern": "\\bmost people\\b", "why": "Unsourced generalisation." },
      { "id": "arrows", "pattern": "[\\x{2190}-\\x{21FF}\\x{27A1}\\x{2B05}-\\x{2B07}\\x{2934}\\x{2935}\\x{25B6}\\x{25C0}\\x{1F446}-\\x{1F449}]", "why": "Emoji arrows." },
      { "id": "siren", "pattern": "\\x{1F6A8}", "why": "Sirens." },
      { "id": "all-caps", "pattern": "(?<![\\p{L}\\d])(?:\\p{Lu}{2,}[\\s,.!?'’-]+){2,}\\p{Lu}{2,}(?![\\p{L}])", "why": "All-caps sentences: three or more capitalised words in a row." }
    ]
  },

  "components": {
    "hook":         { "in": "punch, visible from frame 0", "out": "wipe", "fills": "full-bleed photo, scoreboard strip, hook panel, credit" },
    "matchup":      { "in": "bands slide in, words rise", "out": "wipe" },
    "score_block":  { "in": "punch-in, counter ticks", "out": "wipe" },
    "goal":         { "in": "flash, punch \"Goal\", words rise, counter ticks", "out": "wipe" },
    "red_card":     { "in": "card slides in, words rise", "out": "wipe" },
    "stat_bars":    { "in": "rows rise, bars grow from the centre", "out": "wipe" },
    "mini_table":   { "in": "rows rise one by one", "out": "wipe" },
    "form_chips":   { "in": "chips pop left to right", "out": "wipe" },
    "head_to_head": { "in": "counts punch in", "out": "wipe" },
    "profile":      { "in": "photo pushes in, words rise", "out": "wipe" },
    "roster":       { "in": "rows rise one by one", "out": "wipe" },
    "fixtures":     { "in": "rows rise", "out": "wipe" },
    "fact_list":    { "in": "lines rise", "out": "wipe" },
    "banter":       { "in": "words rise one by one on yellow", "out": "wipe" },
    "closing":      { "in": "question word by word, follow ask punches in", "out": "hold" },
    "photo_credit": { "in": "none, present for the whole cut", "out": "with its cut" },
    "radio_cover":  { "in": "caption words appear as they are spoken", "out": "cut" }
  }
}
